# CyberDeck Tab5 - Basis-Konfiguration
# Ziel: idf.py set-target esp32p4

# --- PSRAM (32MB Octal, laut docs.m5stack.com/en/core/Tab5) ---
# ESP32-P4-Kconfig kennt nur "SPIRAM_MODE_HEX" als Auswahl-Item; Octal-PSRAM
# wird darunter per SPIRAM_USE_8LINE_MODE aktiviert (siehe
# components/esp_psram/esp32p4/Kconfig.spiram in ESP-IDF v5.4.1).
# 200MHz PSRAM-Takt ist auf echter Hardware VERIFIZIERT ERFORDERLICH, nicht
# nur "nice to have": bei 20MHz (Default) kommt das DPI/MIPI-Display nicht
# hinterher, echte Fehlermeldung "can't fetch data from external memory
# fast enough, underrun happens". Bestaetigt durch M5Stacks eigene
# Werksfirmware (M5Tab5-UserDemo/platforms/tab5/sdkconfig.defaults), die
# ebenfalls CONFIG_SPIRAM_SPEED_200M + CONFIG_IDF_EXPERIMENTAL_FEATURES nutzt.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_USE_8LINE_MODE=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# --- Flash (16MB) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- USB Host (Phase 5: Remote-Flashing angeschlossener ESP-Boards, siehe
#     components/core/usb_host/ + docs/usb_host.md) ---
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024

# --- Remote-Server (Phase 5, siehe components/core/remote/ +
#     docs/remote_access.md). WS_SUPPORT wird fuer /api/v1/ws und
#     /api/v1/serial benoetigt (httpd_ws_frame_t/httpd_ws_recv_frame). Etwas
#     mehr Sockets als der Default fuer REST + 2 WebSocket-Verbindungen +
#     Spielraum fuer den bestehenden esp_hosted/Wi-Fi-Stack.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=16

# --- FreeRTOS: genug Headroom fuer LVGL + Modul-Tasks ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# --- Log-Level: waehrend Phase 1 ausfuehrlich, spaeter auf INFO reduzieren ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- NVS-Verschluesselung ---
# Bewusst NICHT in Phase 1 aktiviert: CONFIG_NVS_ENCRYPTION braucht eine
# durchdachte eFuse-Key-Provisionierung (HMAC-Key-Block), die als Sicherheits-
# feature sauber eingefuehrt werden soll statt blind angeschaltet zu werden -
# siehe Implementierungsplan Abschnitt 6 (Server-API), wird in Phase 4 mit
# echtem Provisioning-Workflow nachgezogen, wenn Server-Zugangsdaten dazukommen.
# CONFIG_NVS_ENCRYPTION=y

# --- Compiler-Optimierung ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- LVGL-Schriftgroessen ---
# Das 5"-Panel hat bei 1280x720 eine hohe Pixeldichte (~294 PPI) - der
# LVGL-Default (Montserrat 14) wirkt darauf sehr klein. Zusaetzliche
# Groessen fuer Karten-Titel/Ueberschriften (24) und normalen Screen-Text
# (20) aktiviert, siehe components/ui/theme/theme.h.
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# --- Wi-Fi ueber ESP32-C6-Co-Prozessor (esp_hosted/esp_wifi_remote) ---
# Das Wi-Fi-Radio sitzt NICHT auf dem ESP32-P4, sondern auf dem separaten
# ESP32-C6-MINI-1U, angebunden per SDIO2. Diese Werte sind NICHT geraten,
# sondern 1:1 aus der generierten sdkconfig der offiziellen M5Tab5-UserDemo-
# Werksfirmware uebernommen (platforms/tab5/sdkconfig, esp_hosted-Default fuer
# die esp32p4-Host/esp32c6-Slave-Kombination) - siehe docs/hardware_reference.md.
# Pins bestaetigen die vorher unter PIN_ROLE_INTERNAL gefuehrten SDIO2-Pins
# (GPIO 8-13 Daten/Takt/Cmd, GPIO 15 C6-Reset, aktiv-low).
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=13
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=12
CONFIG_ESP_HOSTED_SDIO_PIN_D0=11
CONFIG_ESP_HOSTED_SDIO_PIN_D1=10
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=10
CONFIG_ESP_HOSTED_SDIO_PIN_D2=9
CONFIG_ESP_HOSTED_SDIO_PIN_D3=8
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=20
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=20
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=15
CONFIG_ESP_HOSTED_RESET_GPIO_ACTIVE_LOW=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
